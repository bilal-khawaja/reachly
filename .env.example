DATABASE_URL=postgresql://postgres:your_password@localhost:5432/outreach_crm
# generate: python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=change_me_to_a_long_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_MAX_DAYS=7

# Public URL of the app, used in invite links (`just invite email`)
APP_URL=http://localhost:5173

# Production: hides /docs and CORS, adds HSTS. Set to "production" on the server.
ENV=development
# Set true only when behind a reverse proxy you trust (Railway/Render/...), so login rate-limit sees real client IPs.
TRUST_PROXY=false
